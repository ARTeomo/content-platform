# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://content:content@localhost:5432/content_platform

# Separate database for integration tests.
# Migrations must be applied here too before running pnpm test.
TEST_DATABASE_URL=postgresql://content:content@localhost:5432/content_platform_test

# ---------------------------------------------------------------------------
# Redis / BullMQ
#
# Upstash Redis (TLS). Format: rediss://default:<password>@<host>:<port>
# Create at https://upstash.com — Regional, TLS enabled, eviction disabled.
REDIS_URL=rediss://default:password@host.upstash.io:6379

# Separate Redis database for integration tests (Upstash).
# Use the same Upstash instance; the dispatcher test flushes its own keys only.
TEST_REDIS_URL=rediss://default:password@host.upstash.io:6379
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Webhook encryption (verify token, App-level)
# Generate with: openssl rand -base64 32
# ---------------------------------------------------------------------------
WEBHOOK_TOKEN_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Meta credential encryption (Page Access Token, App Secret)
#
# Format: JSON object mapping key version -> base64 key.
# Generate each value with: openssl rand -base64 32
# Example: {"1":"<base64-key>","2":"<base64-key>"}
# ---------------------------------------------------------------------------
META_CREDENTIAL_ENCRYPTION_KEYS=
META_CREDENTIAL_ENCRYPTION_ACTIVE_VERSION=1

# ---------------------------------------------------------------------------
# Meta Graph API
# ---------------------------------------------------------------------------
META_GRAPH_API_VERSION=v21.0
META_APP_ID=
META_APP_SECRET=

# ---------------------------------------------------------------------------
# Meta Page Access Token (TEMPORARY SHORTCUT)
#
# Used by the worker's Graph API calls (content.publish, webhook.respond,
# publication.reconcile). When unset, the worker still starts, but every
# outbound Graph API call fails with AUTHENTICATION_ERROR.
#
# This is a temporary shortcut. The DB-backed encrypted credential
# lifecycle (MetaCredentialService, provider_credentials table) already
# exists but is not yet wired into the worker. It will replace this
# environment variable in a later phase.
#
# Generate a System User token in the Meta Business Suite:
#   Settings → System Users → contentplatform-bot → Generate New Token
#   App: content-platform-dev
#   Expiration: Never
#   Scopes: pages_manage_posts, pages_manage_engagement,
#           pages_read_engagement, pages_show_list
# ---------------------------------------------------------------------------
META_PAGE_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# Outbox dispatcher
# ---------------------------------------------------------------------------
OUTBOX_DISPATCH_BATCH_SIZE=100
OUTBOX_DISPATCH_IDLE_BACKOFF_MS=2000
OUTBOX_DISPATCH_MAX_ATTEMPTS=10
OUTBOX_DISPATCH_STALE_THRESHOLD_SECONDS=60
OUTBOX_RECOVERY_INTERVAL_SECONDS=30
OUTBOX_CLEANUP_RETENTION_DAYS=7

# ---------------------------------------------------------------------------
# Publication scheduler
#
# The scheduler runs as an in-process polling worker in apps/worker. It
# scans the publications table for due SCHEDULED rows and stale
# RECONCILIATION rows, and enqueues the corresponding outbox work.
# ---------------------------------------------------------------------------
PUBLICATION_SCHEDULE_INTERVAL_MS=30000
PUBLICATION_SCHEDULE_BATCH_SIZE=50
PUBLICATION_RECONCILE_STALE_THRESHOLD_SECONDS=300

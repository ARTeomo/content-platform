# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://content:content@localhost:5432/content_platform
TEST_DATABASE_URL=postgresql://content:content@localhost:5432/content_platform_test

# ---------------------------------------------------------------------------
# Redis / BullMQ
# ---------------------------------------------------------------------------
REDIS_URL=rediss://default:password@host.upstash.io:6379
TEST_REDIS_URL=rediss://default:password@host.upstash.io:6379

# ---------------------------------------------------------------------------
# Webhook verify token encryption
#
# Two formats are supported. The legacy single-key format is retained
# for backward compatibility; new setups should use the versioned
# format so that key rotation is possible.
#
# Generate each key with: openssl rand -base64 32
#
# Legacy (single key, no rotation):
#   WEBHOOK_TOKEN_ENCRYPTION_KEY=<base64-32-bytes>
#
# Versioned (multiple keys, supports rotation):
#   WEBHOOK_TOKEN_ENCRYPTION_KEYS={"1":"<base64-key>","2":"<base64-key>"}
#   WEBHOOK_TOKEN_ENCRYPTION_ACTIVE_VERSION=1
#
# When both formats are present, the versioned one wins.
# ---------------------------------------------------------------------------
WEBHOOK_TOKEN_ENCRYPTION_KEY=
WEBHOOK_TOKEN_ENCRYPTION_KEYS=
WEBHOOK_TOKEN_ENCRYPTION_ACTIVE_VERSION=1

# ---------------------------------------------------------------------------
# Meta credential encryption (Page Access Token, App Secret)
#
# Format: JSON object mapping key version -> base64 key.
# Generate each value with: openssl rand -base64 32
# ---------------------------------------------------------------------------
META_CREDENTIAL_ENCRYPTION_KEYS=
META_CREDENTIAL_ENCRYPTION_ACTIVE_VERSION=1

# ---------------------------------------------------------------------------
# Meta Graph API
# ---------------------------------------------------------------------------
META_GRAPH_API_VERSION=v21.0
META_APP_ID=
META_APP_SECRET=

# ---------------------------------------------------------------------------
# Meta System User Access Token
#
# Used only by packages/database/scripts/refresh-page-token.mjs to
# derive a Page Access Token and store it (encrypted) in
# provider_credentials. Never read at worker runtime.
# ---------------------------------------------------------------------------
META_USER_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# Outbox dispatcher
# ---------------------------------------------------------------------------
OUTBOX_DISPATCH_BATCH_SIZE=100
OUTBOX_DISPATCH_IDLE_BACKOFF_MS=2000
OUTBOX_DISPATCH_MAX_ATTEMPTS=10
OUTBOX_DISPATCH_STALE_THRESHOLD_SECONDS=60
OUTBOX_RECOVERY_INTERVAL_SECONDS=30
OUTBOX_CLEANUP_RETENTION_DAYS=7

# ---------------------------------------------------------------------------
# System.outbox.cleanup scheduler
#
# Polling interval in milliseconds for the cleanup scheduler. Zero
# disables the scheduler, in which case a `system.outbox.cleanup` job
# must be published manually to trigger a sweep.
# ---------------------------------------------------------------------------
SYSTEM_OUTBOX_CLEANUP_INTERVAL_MS=3600000

# ---------------------------------------------------------------------------
# Publication scheduler
# ---------------------------------------------------------------------------
PUBLICATION_SCHEDULE_INTERVAL_MS=30000
PUBLICATION_SCHEDULE_BATCH_SIZE=50
PUBLICATION_RECONCILE_STALE_THRESHOLD_SECONDS=300

# ---------------------------------------------------------------------------
# Interaction response scheduler
# ---------------------------------------------------------------------------
INTERACTION_RESPONSE_SCHEDULE_INTERVAL_MS=30000
INTERACTION_RESPONSE_SCHEDULE_BATCH_SIZE=50
INTERACTION_RESPONSE_STALE_THRESHOLD_SECONDS=300

# ---------------------------------------------------------------------------
# System rebuild
#
# Default values used when a `system.rebuild` job omits a scope-specific
# override. The rebuild is a safety net for the case where BullMQ state
# is lost while durable PostgreSQL state still has work to run.
# ---------------------------------------------------------------------------
SYSTEM_REBUILD_STALE_THRESHOLD_SECONDS=300
SYSTEM_REBUILD_BATCH_SIZE=100

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://content:content@localhost:5432/content_platform
TEST_DATABASE_URL=postgresql://content:content@localhost:5432/content_platform_test

# ---------------------------------------------------------------------------
# Redis / BullMQ
# ---------------------------------------------------------------------------
REDIS_URL=rediss://default:password@host.upstash.io:6379
TEST_REDIS_URL=rediss://default:password@host.upstash.io:6379

# ---------------------------------------------------------------------------
# Webhook encryption (verify token, App-level)
# Generate with: openssl rand -base64 32
# ---------------------------------------------------------------------------
WEBHOOK_TOKEN_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Meta credential encryption (Page Access Token, App Secret)
#
# Format: JSON object mapping key version -> base64 key.
# Generate each value with: openssl rand -base64 32
# Example: {"1":"<base64-key>","2":"<base64-key>"}
# ---------------------------------------------------------------------------
META_CREDENTIAL_ENCRYPTION_KEYS=
META_CREDENTIAL_ENCRYPTION_ACTIVE_VERSION=1

# ---------------------------------------------------------------------------
# Meta Graph API
# ---------------------------------------------------------------------------
META_GRAPH_API_VERSION=v21.0
META_APP_ID=
META_APP_SECRET=

# ---------------------------------------------------------------------------
# Meta Page Access Token (TEMPORARY SHORTCUT)
#
# Deprecated. Used only as a fallback when the DB-backed credential is
# not yet seeded for a destination. Every fallback use is logged at
# warn level. Remove once the credential migration is complete.
# ---------------------------------------------------------------------------
META_PAGE_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# Outbox dispatcher
# ---------------------------------------------------------------------------
OUTBOX_DISPATCH_BATCH_SIZE=100
OUTBOX_DISPATCH_IDLE_BACKOFF_MS=2000
OUTBOX_DISPATCH_MAX_ATTEMPTS=10
OUTBOX_DISPATCH_STALE_THRESHOLD_SECONDS=60
OUTBOX_RECOVERY_INTERVAL_SECONDS=30
OUTBOX_CLEANUP_RETENTION_DAYS=7

# ---------------------------------------------------------------------------
# Publication scheduler
# ---------------------------------------------------------------------------
PUBLICATION_SCHEDULE_INTERVAL_MS=30000
PUBLICATION_SCHEDULE_BATCH_SIZE=50
PUBLICATION_RECONCILE_STALE_THRESHOLD_SECONDS=300

# ---------------------------------------------------------------------------
# Interaction response scheduler (new in Sprint A)
# ---------------------------------------------------------------------------
INTERACTION_RESPONSE_SCHEDULE_INTERVAL_MS=30000
INTERACTION_RESPONSE_SCHEDULE_BATCH_SIZE=50
INTERACTION_RESPONSE_STALE_THRESHOLD_SECONDS=300
